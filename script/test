#!/usr/bin/env bash
# Runs the unit, property, contract and integration tests of every package, or of the
# packages named first. Arguments after "--" go to each package's test runner.
# Usage: script/test [package...] [-- runner arguments]
#   script/test domain application -- --reporter=verbose
set -euo pipefail
cd "$(dirname "$0")/.."
source script/lib/heavy.sh

readonly MAX_TEST_WORKERS="${AGENT_FACTORY_TEST_MAX_WORKERS:-2}"
export VITEST_MAX_FORKS="$MAX_TEST_WORKERS" VITEST_MIN_FORKS=1 VITEST_MAX_THREADS="$MAX_TEST_WORKERS" VITEST_MIN_THREADS=1

filters=()
while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
  filters+=(--filter "@agent-factory/$1")
  shift
done
if [ "${1:-}" = "--" ]; then
  shift
fi
# The ${array[@]+...} form keeps an empty array valid under `set -u` in bash 3.2.
run_heavy pnpm -r ${filters[@]+"${filters[@]}"} --workspace-concurrency=1 --if-present run test "$@"
