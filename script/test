#!/usr/bin/env bash
# Runs the unit, property, contract and integration tests of every package.
# Extra arguments go to vitest, for example: script/test --project domain
set -euo pipefail
cd "$(dirname "$0")/.."
source script/lib/heavy.sh

readonly MAX_TEST_WORKERS="${AGENT_FACTORY_TEST_MAX_WORKERS:-2}"
run_heavy pnpm -r --workspace-concurrency=1 --if-present run test --maxWorkers="$MAX_TEST_WORKERS" --minWorkers=1 "$@"
