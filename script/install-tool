#!/usr/bin/env bash
# Installs a pinned release of a repository tool into build/tools/bin after checking
# its SHA-256, so CI never installs anything system-wide. Prints the bin directory.
# Usage: script/install-tool <gitleaks|actionlint>
set -euo pipefail
cd "$(dirname "$0")/.."

readonly GITLEAKS_VERSION=8.30.1
readonly ACTIONLINT_VERSION=1.7.12
readonly TOOLS_DIRECTORY=build/tools
readonly BIN_DIRECTORY="$TOOLS_DIRECTORY/bin"

platform() {
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"
  case "$arch" in
    x86_64 | amd64) arch=x64 ;;
    arm64 | aarch64) arch=arm64 ;;
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;;
  esac
  echo "${os}_${arch}"
}

checksum_of() {
  case "$1" in
    gitleaks_darwin_arm64) echo b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5 ;;
    gitleaks_darwin_x64) echo dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709 ;;
    gitleaks_linux_arm64) echo e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080 ;;
    gitleaks_linux_x64) echo 551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb ;;
    actionlint_darwin_arm64) echo aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f ;;
    actionlint_darwin_x64) echo 5b44c3bc2255115c9b69e30efc0fecdf498fdb63c5d58e17084fd5f16324c644 ;;
    actionlint_linux_arm64) echo 325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6 ;;
    actionlint_linux_x64) echo 8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8 ;;
    *) echo "no pinned checksum for $1" >&2; exit 1 ;;
  esac
}

release_url() {
  local tool="$1" target="$2"
  case "$tool" in
    gitleaks)
      echo "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_${target}.tar.gz"
      ;;
    actionlint)
      echo "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_${target/x64/amd64}.tar.gz"
      ;;
    *) echo "unknown tool: $tool" >&2; exit 1 ;;
  esac
}

sha256_of() {
  if command -v sha256sum > /dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

archive=""
trap 'rm -f "$archive"' EXIT

main() {
  local tool="${1:?usage: script/install-tool <gitleaks|actionlint>}"
  local target expected actual
  target="$(platform)"
  mkdir -p "$BIN_DIRECTORY"
  if [ -x "$BIN_DIRECTORY/$tool" ]; then
    echo "$PWD/$BIN_DIRECTORY"
    return
  fi
  archive="$(mktemp)"
  curl --fail --silent --show-error --location --output "$archive" "$(release_url "$tool" "$target")"
  expected="$(checksum_of "${tool}_${target}")"
  actual="$(sha256_of "$archive")"
  if [ "$expected" != "$actual" ]; then
    echo "checksum mismatch for $tool on $target: expected $expected, got $actual" >&2
    exit 1
  fi
  tar -xzf "$archive" -C "$BIN_DIRECTORY" "$tool"
  echo "$PWD/$BIN_DIRECTORY"
}

main "$@"
