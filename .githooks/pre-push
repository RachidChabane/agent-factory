#!/usr/bin/env bash
# Refuses a push whose commits carry a denylisted term (content, paths, messages,
# authors, references) or a secret.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
ranges="$(cat)"
printf '%s\n' "$ranges" | node "$root/tools/denylist/src/scan.ts" --pre-push

if ! command -v gitleaks > /dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed; install it to scan the pushed commits for secrets" >&2
  exit 1
fi
zero='^0+$'
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [[ "$local_sha" =~ $zero ]] && continue
  if [[ "$remote_sha" =~ $zero ]]; then
    log_opts="$local_sha"
  else
    log_opts="$remote_sha..$local_sha"
  fi
  gitleaks git --no-banner --redact --config "$root/.gitleaks.toml" --log-opts="$log_opts" "$root"
  : "$remote_ref"
done <<< "$ranges"
